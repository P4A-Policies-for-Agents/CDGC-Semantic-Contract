# Copy to demo/env.local.sh (gitignored) and `source` it before running the demo.
# Local-only — NEVER commit real values.

# The governed MCP endpoint the demo agent hits (Flex Gateway route + /mcp).
export CSC_GW_URL="https://<omni-gw-small-public-host>/semantic-contract-demo/mcp"

# OPTIONAL — the raw upstream A2D mock (no gateway), for the before/after contrast.
# When set, the agent shows the SAME tools/call with and without the attached contract.
export CSC_RAW_URL="https://www.a2d-ai.com/api/platform/<a2d-mock-server-id>/mcp"

# CDGC / IDMC org credentials used by the policy config at apply time (not by the agent).
export CDGC_LOGIN_URL="https://dm-us.informaticacloud.com"
export CDGC_SEARCH_URL="https://cdgc-api.dm-us.informaticacloud.com"
export CDGC_ORG_USERNAME="<idmc-username>"
export CDGC_ORG_PASSWORD="<idmc-password>"

# The governed data-product schema assets. Each MCP tool is routed to its own schema by the
# policy's toolSchemas map (see demo/config.json.example).
#   get_customer_profiles → Customer 360 Profile  (email_address → Restricted; consent → Confidential)
#   get_product_catalog   → Product Catalog        (unit_cost / list_price → Confidential)
export CSC_CUSTOMER_SCHEMA_ID="<customer-360-schema-asset-id>"
export CSC_PRODUCT_SCHEMA_ID="<product-catalog-schema-asset-id>"
